{
  "name": "commitproof-review",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:web\"",
    "api": "tsx watch server/index.ts",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "tsx": "^4.19.2",
    "concurrently": "^9.1.0",
    "vitest": "^2.1.8"
  }
}